{
    "name": "fansapi/incident-workbench",
    "description": "OnlyFans profile-fetch service incident remediation: strict DTO parsing, monotonic revision guard, and refresh cadence policy.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-json": "*",
        "laravel/framework": "^11.0",
        "laravel/scout": "^10.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
